{{!< default}}

<article class="post {{post_class}}">
    <header class="post-header">
        {{#if primary_tag}}
            <section class="post-tags">
                <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                {{#foreach tags}}
                    {{#unless @first}}
                        <span class="post-tag-separator">·</span>
                        <a href="{{url}}">{{name}}</a>
                    {{/unless}}
                {{/foreach}}
            </section>
        {{/if}}
        <h1 class="post-title">{{title}}</h1>
        {{#if custom_excerpt}}
            <p class="post-excerpt">{{custom_excerpt}}</p>
        {{/if}}
        <div class="post-meta">
            <div class="post-author">
                {{#if primary_author.profile_image}}
                    <img class="author-profile-image" src="{{img_url primary_author.profile_image size="xs"}}" alt="{{primary_author.name}}" />
                {{/if}}
                <div class="post-author-info">
                    <a href="{{primary_author.url}}">{{primary_author.name}}</a>
                    <time class="post-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY年MM月DD日"}}</time>
                </div>
            </div>
            <span class="post-reading-time">{{reading_time}} 阅读</span>
        </div>
    </header>

    {{#if feature_image}}
        <figure class="post-feature-image">
            <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
            {{#if feature_image_caption}}
                <figcaption>{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <section class="post-content">
        {{content}}
    </section>

    <footer class="post-footer">
        {{#if tags}}
            <section class="post-footer-tags">
                <h4>标签</h4>
                <div class="post-footer-tag-list">
                    {{#foreach tags}}
                        <a href="{{url}}" class="post-footer-tag">{{name}}</a>
                    {{/foreach}}
                </div>
            </section>
        {{/if}}

        <section class="author-card">
            {{#if primary_author.profile_image}}
                <img class="author-card-profile" src="{{img_url primary_author.profile_image size="m"}}" alt="{{primary_author.name}}" />
            {{/if}}
            <div class="author-card-content">
                <h4 class="author-card-name"><a href="{{primary_author.url}}">{{primary_author.name}}</a></h4>
                {{#if primary_author.bio}}
                    <p class="author-card-bio">{{primary_author.bio}}</p>
                {{/if}}
            </div>
        </section>
    </footer>
</article>

{{> related-posts}}

{{#if @site.members_enabled}}
    <section class="post-comments">
        <h3 class="comments-title">评论</h3>
        {{comments}}
    </section>
{{/if}}
