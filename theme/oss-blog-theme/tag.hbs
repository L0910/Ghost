{{!< default}}

<header class="tag-header">
    <h1 class="tag-title">{{tag.name}}</h1>
    {{#if tag.description}}
        <p class="tag-description">{{tag.description}}</p>
    {{/if}}
    <div class="tag-meta">
        <span>共 {{tag.count.posts}} 篇文章</span>
    </div>
</header>

<div class="post-feed">
    {{#foreach posts}}
        <article class="post-card {{post_class}}">
            {{#if feature_image}}
                <a class="post-card-image-link" href="{{url}}">
                    <div class="post-card-image" style="background-image: url({{img_url feature_image size="m"}})">
                        {{#if primary_tag}}
                            <span class="post-card-tag">{{primary_tag.name}}</span>
                        {{/if}}
                    </div>
                </a>
            {{/if}}
            <div class="post-card-content">
                <a class="post-card-content-link" href="{{url}}">
                    <h2 class="post-card-title">{{title}}</h2>
                    <p class="post-card-excerpt">{{excerpt words="30"}}</p>
                </a>
                <footer class="post-card-meta">
                    <span class="post-card-author">{{primary_author.name}}</span>
                    <time class="post-card-date">{{date format="YYYY年MM月DD日"}}</time>
                </footer>
            </div>
        </article>
    {{/foreach}}
</div>

{{> pagination}}
