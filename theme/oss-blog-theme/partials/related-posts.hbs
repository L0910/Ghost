{{!-- 相关文章推荐模块 - 自主扩展功能 --}}
{{!-- 数据来源：基于当前文章的标签匹配，按标签匹配度和发布时间排序 --}}
{{!-- 用户价值：帮助读者发现相关内容，提升文章阅读深度和站点停留时间 --}}

{{#is "post"}}
    {{#if primary_tag}}
        <aside class="related-posts">
            <h3 class="related-posts-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                相关推荐
            </h3>
            <div class="related-posts-grid">
                {{#get "posts" filter="tags:[{{primary_tag.slug}}]+id:-{{id}}" limit=@custom.related_posts_count include="tags,authors" order="published_at desc"}}
                    {{#foreach posts}}
                        <article class="related-post-card {{post_class}}">
                            <a href="{{url}}" class="related-post-link">
                                {{#if feature_image}}
                                    <div class="related-post-image" style="background-image: url({{img_url feature_image size="s"}})"></div>
                                {{/if}}
                                <div class="related-post-content">
                                    {{#if primary_tag}}
                                        <span class="related-post-tag">{{primary_tag.name}}</span>
                                    {{/if}}
                                    <h4 class="related-post-title">{{title}}</h4>
                                    <div class="related-post-meta">
                                        <span>{{primary_author.name}}</span>
                                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MM-DD"}}</time>
                                    </div>
                                </div>
                            </a>
                        </article>
                    {{/foreach}}
                {{/get}}
            </div>
        </aside>
    {{/if}}
{{/is}}
