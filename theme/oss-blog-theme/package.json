{
  "name": "oss-blog-theme",
  "description": "开源个人博客系统二次开发 - 自定义主题",
  "version": "2.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "L0910",
    "email": "student@example.com"
  },
  "keywords": ["ghost", "theme", "blog", "oss", "custom"],
  "repository": {
    "type": "git",
    "url": "https://github.com/L0910/Ghost.git"
  },
  "config": {
    "posts_per_page": 6,
    "image_sizes": {
      "xs": { "width": 150 },
      "s": { "width": 400 },
      "m": { "width": 750 },
      "l": { "width": 1000 },
      "xl": { "width": 2000 }
    },
    "card_assets": true,
    "custom": {
      "show_recent_posts": {
        "type": "boolean",
        "default": true
      },
      "related_posts_count": {
        "type": "select",
        "options": ["3", "4", "6"],
        "default": "3"
      },
      "search_highlight": {
        "type": "boolean",
        "default": true
      },
      "accent_color": {
        "type": "color",
        "default": "#15171A"
      }
    }
  }
}
