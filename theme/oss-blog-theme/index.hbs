{{!< default}}

{{#is "home"}}
    {{#if @site.cover_image}}
        <div class="site-hero site-hero-cover" style="background-image: url({{img_url @site.cover_image size="xl"}})">
            <div class="site-hero-overlay">
                <h1 class="site-hero-title">{{@site.title}}</h1>
                <p class="site-hero-description">{{@site.description}}</p>
            </div>
        </div>
    {{else}}
        <div class="site-hero site-hero-no-cover">
            <h1 class="site-hero-title">{{@site.title}}</h1>
            <p class="site-hero-description">{{@site.description}}</p>
        </div>
    {{/if}}
{{/is}}

<div class="post-feed">
    {{#foreach posts}}
        <article class="post-card {{post_class}}">
            {{#if feature_image}}
                <a class="post-card-image-link" href="{{url}}">
                    <div class="post-card-image" style="background-image: url({{img_url feature_image size="m"}})">
                        {{#if primary_tag}}
                            <span class="post-card-tag">{{primary_tag.name}}</span>
                        {{/if}}
                    </div>
                </a>
            {{/if}}
            <div class="post-card-content">
                <a class="post-card-content-link" href="{{url}}">
                    {{#if primary_tag}}
                        <span class="post-card-primary-tag">{{primary_tag.name}}</span>
                    {{/if}}
                    <h2 class="post-card-title">{{title}}</h2>
                    <p class="post-card-excerpt">{{excerpt words="30"}}</p>
                </a>
                <footer class="post-card-meta">
                    <span class="post-card-author">{{primary_author.name}}</span>
                    <time class="post-card-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY年MM月DD日"}}</time>
                    <span class="post-card-reading-time">{{reading_time}}</span>
                </footer>
            </div>
        </article>
    {{/foreach}}
</div>

{{> pagination}}

{{#if @custom.show_recent_posts}}
    <aside class="recent-posts">
        <h3 class="recent-posts-title">最近文章</h3>
        <div class="recent-posts-list">
            {{#get "posts" limit="5" order="published_at desc"}}
                {{#foreach posts}}
                    <a href="{{url}}" class="recent-post-item">
                        <span class="recent-post-title">{{title}}</span>
                        <time class="recent-post-date">{{date format="MM-DD"}}</time>
                    </a>
                {{/foreach}}
            {{/get}}
        </div>
    </aside>
{{/if}}
