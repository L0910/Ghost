# Ghost 环境配置示例文件
# 复制此文件为 .env 并根据实际环境修改
# 注意：.env 文件包含敏感配置，不要提交到Git

# 运行环境
NODE_ENV=development

# 数据库配置（SQLite）
database__client=sqlite3
database__connection__filename=./content/data/ghost.db

# 服务器配置
server__host=127.0.0.1
server__port=2368

# 站点URL
url=http://localhost:2368

# 日志配置
logging__level=info
logging__transports=file,stdout

# 邮件配置（可选，用于发送确认邮件）
# mail__transport=SMTP
# mail__options__host=smtp.example.com
# mail__options__port=587
# mail__options__auth__user=your-email@example.com
# mail__options__auth__pass=your-password

# 上传配置
uploads__maxFileSize=10mb

# 隐私配置
privacy__useUpdateCheck=true
privacy__useRpcPing=false
privacy__useStructuredData=true
