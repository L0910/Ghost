# ==========================================
# 实验项目自定义忽略规则
# ==========================================

# 运行时目录（Ghost运行数据，不提交Git）
runtime/*
!runtime/.gitkeep

# 环境变量文件（含敏感配置）
.env
.env.local
.env.*.local

# 主题打包文件
*.zip

# 本地测试数据
tests/data/
tests/*.json

# 操作系统临时文件
Thumbs.db
ehthumbs.db
Desktop.ini

# 编辑器临时文件
*.swp
*.swo
*~

# 实验报告导出文件（避免大文件）
docs/*.pdf
docs/*.docx
docs/*.pptx

# 数据导出文件（含用户数据，不提交）
*export*.json
content/export/
